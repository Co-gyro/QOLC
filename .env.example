# QOLC 環境変数テンプレート
# 実際の値は .env.local にコピーして記入する（.env.local は git 管理外）

# ============================================================
# Supabase
# ============================================================
# Supabase プロジェクト URL（例: https://abcdefg.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# Anon key（クライアント側で使用、RLSで保護される前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role key（サーバー側のみ、絶対にクライアントへ送らない）
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# USEN PSP（決済プロバイダ）
# ============================================================
# サイトコード / モールコード（テスト: TSJL / TSJM、本番: S203 / A300〜A3ZZ）
USEN_SITE_CD=TSJL
USEN_MALL_CD=TSJM
# HMACキー（64バイトバイナリ）。コードにハードコードしない。供給方法は2系統（base64優先）:
#   サイトのキー: 会員登録系API（entrybyjutyucd, get, inactivate, activate, delete）で使用
#   モールのキー: 与信/売上/取消系API（authbymemberid, salesadd, void 等）で使用
#   テスト: TSJL.NMK（サイト）/ TSJM.NMK（モール）、本番: S203.NMK
#
# 方法1（推奨・Vercel等ファイルレス環境）: 64バイト鍵をbase64化した文字列を設定。
#   生成: base64 < /path/to/TSJL.NMK | tr -d '\n'
#   両方式が設定されている場合は *_B64 を優先する。
USEN_SITE_HMAC_KEY_B64=
USEN_MALL_HMAC_KEY_B64=
# 方法2（ローカル開発）: 鍵ファイルへの絶対パス。*_B64 が空のときのみ参照。
USEN_SITE_HMAC_KEY_PATH=/path/to/TSJL.NMK
USEN_MALL_HMAC_KEY_PATH=/path/to/TSJM.NMK
# 会員ID決済API ベースURL（HMAC-MD5, XMLレスポンス）
#   テスト/本番とも inet-uketsuke1.netmove.jp を使用（区別は site_cd/mall_cd + HMACキー）。
USEN_MEMBER_API_BASE_URL=https://inet-uketsuke1.netmove.jp/payment
# トークン式EC決済API ベースURL（HMAC-SHA256, JSON）。カード登録/EC決済はこちら
USEN_TOKEN_EC_API_BASE_URL=https://inet-uketsuke1.netmove.jp/ec-payment-uhup
# group_id（USEN提供）。設定時は全APIに隠しパラメータとして付与され、サイト鍵で署名する
# （USEN推奨方式・配下複数モールに対応。テスト用と本番用で値が異なる）
USEN_GROUP_ID=
# トークン式チェックコードに使うHMACキー種別（site/mall）。USEN_GROUP_ID 設定時は強制 site
USEN_TOKEN_CHECK_KEY_TYPE=site
# USEN提供のフロントJSライブラリURL（ec-payment-web-adapter-token.umd.js）。USENから別途提供
# 開発用: https://vic29.netmove.co.jp/ec-payment/js/ec-payment-web-adapter-token-20260210.umd.js
# 本番用: https://payment-cdn.netmove.co.jp/ec-payment/static/js/ec-payment-web-adapter-token.umd.20260210.js
NEXT_PUBLIC_USEN_TOKEN_JS_URL=
# （任意）テスト時にSDKが使うUSENサーバURL。未指定なら本番扱い
NEXT_PUBLIC_USEN_TOKEN_EC_API_BASE_URL=

# ============================================================
# LINE 連携（家族向け本命認証 + LINE通知）
# ============================================================
# --- LINE Login チャネル（家族ログイン / OAuth2・OIDC）---
# Channel ID（= OIDC aud）。LINE Developers > Login チャネル
LINE_LOGIN_CHANNEL_ID=
# Channel Secret。id_token(HS256) 署名検証 / state 署名に使用。ハードコード禁止
LINE_LOGIN_CHANNEL_SECRET=
# コールバックURL。未指定なら NEXT_PUBLIC_APP_URL + /api/auth/line/callback を使用。
#   LINE Developers のコールバックURL許可リストに完全一致で登録すること。
#   例(本番): https://app.qolc.jp/api/auth/line/callback
#   例(開発): http://localhost:3000/api/auth/line/callback
LINE_LOGIN_REDIRECT_URI=
# --- Messaging API チャネル（LINE公式アカウント / push通知）---
# 長期チャネルアクセストークン。LINE Developers > Messaging API チャネル
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Messaging チャネルの Channel Secret。Webhook 署名(X-Line-Signature)検証に使用
LINE_MESSAGING_CHANNEL_SECRET=
# --- LIFF（LINEアプリ内でマイページを表示）---
# LIFF ID。LINE Developers の「LINE Login チャネル」に LIFF を追加して取得。
#   エンドポイントURL=<APP_URL>/liff、サイズ=Full、scope=openid profile で登録。
#   クライアントから参照するため NEXT_PUBLIC_ プレフィックス必須。
NEXT_PUBLIC_LIFF_ID=

# ============================================================
# アプリ設定
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
